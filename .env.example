# =============================================================
#  BiblioTech - desktop configuration template
#  Copy to `.env` in this folder and fill in. NEVER commit `.env`.
#
#  The web app has its own file: web/.env.local
#  (copy it from web/.env.local.example)
# =============================================================

# Neon PostgreSQL connection string.
# Get it from https://console.neon.tech -> your project -> Connection Details
#
# Both forms work - the desktop app and the web app each normalise the other's:
#   postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
#   jdbc:postgresql://HOST.neon.tech/neondb?user=USER&password=PASSWORD&sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
