# ─────────────────────────────────────────────────────────────
#  BiblioTech web — local environment
#  Copy to `.env.local` (gitignored) and fill in.
#  On Vercel, set the same keys under Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Neon PostgreSQL connection string (server-side only — no NEXT_PUBLIC_ prefix,
# so it is never bundled into client JavaScript).
# Use a dedicated demo branch for the public deployment, not your main database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# Signs the session cookie. Must be at least 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Public demo guardrails: protects the seeded accounts from being renamed or deleted.
# Set to "true" only on the Vercel deployment.
DEMO_MODE=false
